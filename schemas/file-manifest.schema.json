{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "File Manifest",
  "type": "array",
  "items": {
    "type": "object",
    "required": ["path", "size_bytes", "sha256"],
    "properties": {
      "path": { "type": "string" },
      "size_bytes": { "type": "integer", "minimum": 0 },
      "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
    },
    "additionalProperties": false
  }
}

